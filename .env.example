# Copy this file to .env.local and fill in the values from MongoDB, Firebase, and ImageKit.
# The Next.js app reads this file, and the API loads it on startup.
# Do not commit .env.local.

# Browser
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# API
PORT=4000
CLIENT_ORIGIN=http://localhost:3000
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/tasks

# This address is the only admin. They can invite everyone else as users.
ADMIN_EMAIL=althakeel.com@gmail.com

# Project id is enough for the API to check Firebase sign-in tokens.
# Add the service account only if you later need other Admin APIs.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"

# ImageKit (https://imagekit.io/dashboard/developer/api-keys)
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# Same public ImageKit values, exposed to the browser for uploads
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# Optional. Each in-app notification is also POSTed here as JSON.
# Header X-Webhook-Secret is sent when the secret is set.
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_SECRET=

# Resend (https://resend.com/api-keys). Invite and task emails are sent with this key.
# RESEND_FROM must be an address on a domain verified in Resend.
RESEND_API_KEY=
RESEND_FROM=Boards <noreply@your-verified-domain.com>
